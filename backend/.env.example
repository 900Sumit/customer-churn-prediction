# Database (replace with your own Neon connection string; do not commit backend/.env)
# IMPORTANT: Do NOT add channel_binding=require — Neon pooler does not support it.
DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# Clerk JWT verification. Standard Clerk session tokens use `azp` and are
# checked against FRONTEND_ORIGINS. Only set CLERK_AUDIENCE when the selected
# Clerk JWT template explicitly includes an `aud` claim.
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-clerk-domain.clerk.accounts.dev
# CLERK_AUDIENCE=https://the-exact-audience-from-your-clerk-jwt-template

# Browser frontend origins (must match the token's azp claim when CLERK_AUDIENCE is unset)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
